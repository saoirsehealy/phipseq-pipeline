# Copy to site.env and edit. site.env is not tracked, so your values stay local.
#
#   PHIPSEQ_SERVER   analysis server the GUI logs in to, prefilled on the login
#                    page. Leave blank to type it each time.
#   PHIPSEQ_ROOT     project area a session is confined to. Must be wide enough
#                    to hold BOTH your input data and your results. Blank means
#                    the folder these scripts sit in.
#   PHIPSEQ_PYTHON   interpreter on the analysis server. Needs pandas, numpy,
#                    matplotlib and scipy, plus BLAST+ and EDirect on its PATH.
#                    Run ./bootstrap.sh to find or create a suitable one.
PHIPSEQ_SERVER=
PHIPSEQ_ROOT=
PHIPSEQ_PYTHON=python3

#   PHIPSEQ_REPO     public git URL the pipeline is installed from. The GUI
#                    offers to clone this onto a server that does not have the
#                    scripts yet, so a colleague needs only the GUI file.
PHIPSEQ_REPO=
